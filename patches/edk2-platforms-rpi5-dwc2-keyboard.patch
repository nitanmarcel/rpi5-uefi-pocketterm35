@@ -635,6 +635,15 @@
   # USB Support
   #
   MdeModulePkg/Bus/Pci/XhciDxe/XhciDxe.inf
+  # PocketTerm35: the keyboard sits on the USB-C DWC2 OTG core (host mode)
+  Platform/RaspberryPi/Drivers/DwUsbHostDxe/DwUsbHostDxe.inf {
+    <PcdsFixedAtBuild>
+      # the AXI bus maps DRAM 1:1 for this core (Linux /axi dma-ranges)
+      gEmbeddedTokenSpaceGuid.PcdDmaDeviceOffset|0x0
+      gEmbeddedTokenSpaceGuid.PcdDmaDeviceLimit|0xBFFFFFFF
+    <BuildOptions>
+      GCC:*_*_*_CC_FLAGS = -DDWC2_BCM2712
+  }
   MdeModulePkg/Bus/Usb/UsbBusDxe/UsbBusDxe.inf
   MdeModulePkg/Bus/Usb/UsbKbDxe/UsbKbDxe.inf
   MdeModulePkg/Bus/Usb/UsbMassStorageDxe/UsbMassStorageDxe.inf
