@@ -152,8 +152,22 @@ typedef struct {
   USB_NS_KEY                           *CurrentNsKey;
   EFI_KEY_DESCRIPTOR                   *KeyConvertionTable;
   EFI_EVENT                            KeyboardLayoutEvent;
+  //
+  // Non-zero for a keyboard used in report protocol whose keyboard report
+  // carries this report ID in front of the 8-byte boot layout (PocketTerm35).
+  //
+  UINT8                                ReportId;
 } USB_KB_DEV;
 
+//
+// PocketTerm35 keyboard: a CircuitPython RP2040 whose HID interface is not
+// boot-capable (subclass 0, protocol 0); its keyboard report is report ID 1
+// followed by the 8-byte boot layout, report IDs 2 and 3 are mouse and media.
+//
+#define POCKETTERM_KB_VID        0x1209
+#define POCKETTERM_KB_PID        0x0001
+#define POCKETTERM_KB_REPORT_ID  1
+
