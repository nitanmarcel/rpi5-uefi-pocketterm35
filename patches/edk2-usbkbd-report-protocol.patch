+
+/**
+  Check for the PocketTerm35 keyboard, which only speaks report protocol.
+
+  @param  UsbIo                Pointer to a USB I/O protocol instance.
+  @param  InterfaceDescriptor  Its default interface descriptor.
+
+  @retval TRUE     The PocketTerm35 keyboard HID interface.
+  @retval FALSE    Something else.
+
+**/
+BOOLEAN
+IsPocketTermKeyboard (
+  IN  EFI_USB_IO_PROTOCOL           *UsbIo,
+  IN  EFI_USB_INTERFACE_DESCRIPTOR  *InterfaceDescriptor
+  )
+{
+  EFI_USB_DEVICE_DESCRIPTOR  DeviceDescriptor;
+
+  if ((InterfaceDescriptor->InterfaceClass != CLASS_HID) ||
+      (InterfaceDescriptor->InterfaceSubClass == SUBCLASS_BOOT))
+  {
+    return FALSE;
+  }
+
+  if (EFI_ERROR (UsbIo->UsbGetDeviceDescriptor (UsbIo, &DeviceDescriptor))) {
+    return FALSE;
+  }
+
+  return (BOOLEAN)((DeviceDescriptor.IdVendor == POCKETTERM_KB_VID) &&
+                   (DeviceDescriptor.IdProduct == POCKETTERM_KB_PID));
 }
 
